# Copy these values into your deployment environment. Do not commit real secrets.
# Local development only: set DJANGO_DEBUG=true and use a unique development secret.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production example (configure at your hosting provider):
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=your-api-domain.example
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false

# Subscription checkout (Flutterwave)
# Keep real credentials in your deployment's secret manager, never in Git.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FRONTEND_URL=http://localhost:5173
# Optional: configure a stable callback URL in your Flutterwave dashboard.
FLW_REDIRECT_URL=http://localhost:5173/subscription
# Optional provider-managed recurring plans. Set IDs only after creating matching
# UGX 30-day plans in the Flutterwave dashboard.
# FLW_PAYMENT_PLAN_STARTER=
# FLW_PAYMENT_PLAN_BUSINESS=
